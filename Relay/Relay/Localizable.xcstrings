          "stringUnit": {
            "state": "translated",
            "value": "取代你目前的資料？"
          }
        }
      }
    },
    "Importing this backup replaces all your current profiles, shortcuts, behaviors, and settings. A snapshot is taken first.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入此备份会替换你当前的全部情景模式、快捷键、行为和设置。导入前会先创建一份快照。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入此備份會取代你目前的全部情景、快捷鍵、行為和設定。匯入前會先建立一份快照。"
          }
        }
      }
    },
    "Import & Replace": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入并替换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入並取代"
          }
        }
      }
    },
    "Reset Relay to defaults?": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Relay 重置为默认？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 Relay 重設為預設？"
          }
        }
      }
    },
    "This replaces all your current profiles, shortcuts, behaviors, and settings with the defaults. A snapshot is taken first.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会把你当前的全部情景模式、快捷键、行为和设置替换为默认值。重置前会先创建一份快照。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會把你目前的全部情景、快捷鍵、行為和設定取代為預設值。重設前會先建立一份快照。"
          }
        }
      }
    },
    "Couldn’t restore snapshot": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复快照"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法復原快照"
          }
        }
      }
    },
    "Restore this snapshot?": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复此快照？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原此快照？"
          }
        }
      }
    },
    "Restoring replaces all your current data with this snapshot. A new snapshot of your current data is taken first.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复会用此快照替换你当前的全部数据。恢复前会先为你当前的数据创建一份新快照。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原會用此快照取代你目前的全部資料。復原前會先為你目前的資料建立一份新快照。"
          }
        }
      }
    },
    "Couldn’t create a safety snapshot": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建安全快照"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法建立安全快照"
          }
        }
      }
    },
    "Relay couldn’t save a snapshot of your current data before this change. If you continue, you won’t be able to undo it. Continue anyway?": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay 无法在此次更改前保存你当前数据的快照。若继续，将无法撤销。仍要继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay 無法在此次變更前儲存你目前資料的快照。若繼續，將無法復原。仍要繼續嗎？"
          }
        }
      }
    },
    "Continue Anyway": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍然继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍然繼續"
          }
        }
      }
    },
    "This backup was created by a newer version of Relay and can’t be imported. Update Relay and try again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份由更新版本的 Relay 创建，无法导入。请更新 Relay 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此備份由較新版本的 Relay 建立，無法匯入。請更新 Relay 後重試。"
          }
        }
      }
    },
    "This file isn’t a valid Relay backup, or it’s damaged.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
