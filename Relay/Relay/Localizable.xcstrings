    "Each behavior names what happens when you trigger a shortcut, based on the target app's state. Shortcuts reference a behavior by name.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个行为根据目标 App 的状态，定义触发快捷键时会发生什么。快捷键按名称引用行为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個行為根據目標 App 的狀態，定義觸發快捷鍵時會發生什麼。快捷鍵以名稱引用行為。"
          }
        }
      }
    },
